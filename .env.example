# Required: the LLM that answers questions, as "<provider>:<model>" (anthropic or openai)
LLM_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional: Spotify login for live data (playlists, genres, now playing).
# Client ID from https://developer.spotify.com/dashboard; no secret needed.
VITE_SPOTIFY_CLIENT_ID=

# Optional: IANA timezone for local timestamps (defaults to this machine's)
# TZ_NAME=America/New_York
